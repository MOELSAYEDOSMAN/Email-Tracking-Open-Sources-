# ---------------------------------------------------------------------------
# Email Tracking - Docker Compose environment
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env          (Windows PowerShell: Copy-Item .env.example .env)
#
# `.env` is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# ------------------------------- MongoDB ------------------------------------
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me-too
MONGO_DATABASE=EmailTrackingAPI
# Host port mapped to the container's 27017. Change it if 27017 is taken.
MONGO_PORT=27017

# ------------------------------- API ----------------------------------------
# Host port the API is published on: http://localhost:<API_PORT>
API_PORT=5099
# Development enables the OpenAPI document at /openapi/v1.json.
# Use Production in anything reachable from the internet.
ASPNETCORE_ENVIRONMENT=Production

# ------------------------------- SMTP ---------------------------------------
# For Gmail you must use an App Password, not your account password:
# https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=you@example.com
